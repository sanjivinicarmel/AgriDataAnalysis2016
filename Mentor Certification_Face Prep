      "source": [
        "import torch\n",
        "import torch.distributed as dist\n",
        "import torch.nn as nn\n",
        "from torch.nn.parallel import DistributedDataParallel as DDP\n",
        "import os\n",
        "\n",
        "class DummyModel(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.linear = nn.Linear(10, 1)\n",
        "    def forward(self, x):\n",
        "        return self.linear(x)\n",
        "\n",
        "# Initialize model, loss, and optimizer\n",
        "model = DummyModel()\n",
        "optimizer = torch.optim.SGD(model.parameters(), lr=0.01)\n",
        "input_data = torch.randn(1, 10)\n",
        "target = torch.randn(1, 1)\n",
        "output = model(input_data)\n",
        "loss = torch.nn.functional.mse_loss(output, target)\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "if not dist.is_initialized():\n",
        "    print(\"Initializing distributed process group (DDP is typically run with multiple processes).\")\n",
        "    os.environ['MASTER_ADDR'] = 'localhost'\n",
        "    os.environ['MASTER_PORT'] = '12355'\n",
        "    os.environ['RANK'] = '0'\n",
        "    os.environ['WORLD_SIZE'] = '1'\n",
        "    try:\n",
        "        dist.init_process_group(backend='gloo', rank=0, world_size=1) # Use gloo for CPU, nccl for GPU\n",
        "        print(\"Distributed process group initialized with backend 'gloo'.\")\n",
        "    except RuntimeError as e:\n",
        "        print(f\"Could not initialize distributed process group: {e}. Skipping DDP operations.\")\n",
        "        dist = None\n",
        "\n",
        "if dist is not None and dist.is_initialized():\n",
        "    # Wrap Model with DDP\n",
        "    model = DDP(model)\n",
        "\n",
        "    # Synchronize Gradients\n",
        "    loss.backward()\n",
        "    optimizer.step()\n",
        "\n",
        "    # Synchronize All Processes\n",
        "    dist.barrier()\n",
        "\n",
        "    # Benchmark Training\n",
        "    print(\"Training completed on\", dist.get_world_size(), \"GPUs (simulated if single process).\")\n",
        "else:\n",
        "    print(\"Distributed training is not initialized. Skipping DDP operations.\")\n",
        "    loss.backward()\n",
        "    optimizer.step()\n",
        "    print(\"Training completed on single device (DDP not active).\")"
