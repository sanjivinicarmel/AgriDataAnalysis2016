        "import torch\n",
        "import torch.nn.functional as F\n",
        "\n",
        "def bbox_iou(box1, box2, CIoU=False):\n",
        "    b1_x1, b1_y1 = box1[:, 0] - box1[:, 2] / 2, box1[:, 1] - box1[:, 3] / 2\n",
        "    b1_x2, b1_y2 = box1[:, 0] + box1[:, 2] / 2, box1[:, 1] + box1[:, 3] / 2\n",
        "    b2_x1, b2_y1 = box2[:, 0] - box2[:, 2] / 2, box2[:, 1] - box2[:, 3] / 2\n",
        "    b2_x2, b2_y2 = box2[:, 0] + box2[:, 2] / 2, box2[:, 1] + box2[:, 3] / 2\n",
        "\n",
        "    inter_x1 = torch.max(b1_x1, b2_x1)\n",
        "    inter_y1 = torch.max(b1_y1, b2_y1)\n",
        "    inter_x2 = torch.min(b1_x2, b2_x2)\n",
        "    inter_y2 = torch.min(b1_y2, b2_y2)\n",
        "\n",
        "    inter_width = torch.clamp(inter_x2 - inter_x1, min=0)\n",
        "    inter_height = torch.clamp(inter_y2 - inter_y1, min=0)\n",
        "    inter_area = inter_width * inter_height\n",
        "\n",
        "    b1_area = (b1_x2 - b1_x1) * (b1_y2 - b1_y1)\n",
        "    b2_area = (b2_x2 - b2_x1) * (b2_y2 - b2_y1)\n",
        "    union_area = b1_area + b2_area - inter_area\n",
        "\n",
        "    iou = inter_area / (union_area + 1e-8)\n",
        "\n",
        "    if CIoU:\n",
        "        center_dist_sq = (box1[:, 0] - box2[:, 0])**2 + (box1[:, 1] - box2[:, 1])**2\n",
        "\n",
        "        c_x1 = torch.min(b1_x1, b2_x1)\n",
        "        c_y1 = torch.min(b1_y1, b2_y1)\n",
        "        c_x2 = torch.max(b1_x2, b2_x2)\n",
        "        c_y2 = torch.max(b1_y2, b2_y2)\n",
        "        enclosing_diag_sq = (c_x2 - c_x1)**2 + (c_y2 - c_y1)**2\n",
        "\n",
        "        enclosing_diag_sq = torch.where(enclosing_diag_sq == 0, torch.tensor(1e-8, device=enclosing_diag_sq.device, dtype=enclosing_diag_sq.dtype), enclosing_diag_sq)\n",
        "\n",
        "        ciou_dist_penalty = center_dist_sq / enclosing_diag_sq\n",
        "\n",
        "        return iou - ciou_dist_penalty * 0.1\n",
