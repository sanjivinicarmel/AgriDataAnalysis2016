        "Uo = np.random.randn(hidden_dim, hidden_dim)\n",
        "Uc = np.random.randn(hidden_dim, hidden_dim)\n",
        "\n",
        "bi = np.random.randn(hidden_dim)\n",
        "bf = np.random.randn(hidden_dim)\n",
        "bo = np.random.randn(hidden_dim)\n",
        "bc = np.random.randn(hidden_dim)\n",
        "\n",
        "i = sigmoid(x @ Wi + h @ Ui + bi)\n",
        "f = sigmoid(x @ Wf + h @ Uf + bf)\n",
