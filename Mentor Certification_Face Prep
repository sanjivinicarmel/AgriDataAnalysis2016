    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "# Input image dimensions (example: 1 sample, 32x32 pixels, 3 channels)\n",
        "input_image = np.random.rand(1, 32, 32, 3)\n",
        "\n",
        "# Convolutional layer parameters\n",
        "input_channels = input_image.shape[-1]\n",
        "kernel_size = 3\n",
        "out_channels = 16\n",
        "stride = 1\n",
        "pad = 1\n",
        "\n",
        "kernel = np.random.rand(kernel_size, kernel_size, input_channels, out_channels)\n",
        "\n",
        "\n",
        "\n",
        "input_height = input_image.shape[1]\n",
        "input_width = input_image.shape[2]\n",
        "out_h = (input_height - kernel_size + 2 * pad) // stride + 1\n",
        "out_w = (input_width - kernel_size + 2 * pad) // stride + 1\n",
        "\n",
        "# The im2col function (corrected to handle multiple input channels and batch dimension)\n",
        "def im2col(X_batch, k, stride_val, pad_val):\n",
        "    N, H, W, C = X_batch.shape\n",
        "\n",
        "    # Pad the input image\n",
        "    X_padded = np.pad(X_batch, ((0,0), (pad_val,pad_val), (pad_val,pad_val), (0,0)), mode='constant')\n",
        "\n",
        "    # Calculate output dimensions after padding and striding\n",
        "    out_h = (H - k + 2 * pad_val) // stride_val + 1\n",
        "    out_w = (W - k + 2 * pad_val) // stride_val + 1\n",
        "\n",
        "    # A basic version of im2col that can handle channels for a single image, then batch\n",
        "    output_shape = (N, out_h, out_w, k, k, C)\n",
        "    strides = (X_padded.strides[0],\n",
        "               X_padded.strides[1] * stride_val,\n",
        "               X_padded.strides[2] * stride_val,\n",
        "               X_padded.strides[1],\n",
        "               X_padded.strides[2],\n",
        "               X_padded.strides[3])\n",
        "\n",
        "    windows = np.lib.stride_tricks.as_strided(X_padded, shape=output_shape, strides=strides, writeable=False)\n",
        "    windows = windows.reshape(N * out_h * out_w, k * k * C)\n",
        "    return windows\n",
        "\n",
        "\n",
        "\n",
        "# Original definition of im2col (this assumes X is 2D)\n",
        "def im2col_2d(X_2d, k):\n",
        "    return np.lib.stride_tricks.sliding_window_view(X_2d, (k, k)).reshape(-1, k*k)\n",
        "\n",
        "\n",
        "\n",
        "X_single_channel = input_image[0, :, :, 0]\n",
        "\n",
        "X_single_channel_padded = np.pad(X_single_channel, ((pad,pad),(pad,pad)), mode='constant')\n",
        "\n",
        "X_col = im2col_2d(X_single_channel_padded, kernel_size)\n",
        "K_col = kernel[:,:,0,0].reshape(-1, 1)\n",
        "output = X_col @ K_col\n",
        "output = output.reshape(out_h, out_w, 1)\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "X_processed = im2col(input_image, kernel_size, stride, pad)\n",
        "\n",
        "\n",
        "kernel_reshaped = kernel.reshape(-1, out_channels)\n",
        "\n",
        "output_matrix = X_processed @ kernel_reshaped\n",
        "\n",
        "\n",
        "output = output_matrix.reshape(input_image.shape[0], out_h, out_w, out_channels)\n",
        "\n",
        "# Displaying shapes to confirm\n",
        "print(f\"Shape of X_processed (im2col output): {X_processed.shape}\")\n",
        "print(f\"Shape of kernel_reshaped: {kernel_reshaped.shape}\")\n",
        "print(f\"Shape of final output: {output.shape}\")"
      ],
