        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.metrics import precision_recall_curve\n",
        "\n",
        "class DummyUnet(nn.Module):\n",
        "    def __init__(self, in_channels, out_channels, img_size):\n",
        "        super().__init__()\n",
        "        self.conv = nn.Conv2d(in_channels, out_channels, kernel_size=1)\n",
        "        self.img_size = img_size\n",
        "\n",
        "    def forward(self, x):\n",
        "        return torch.sigmoid(self.conv(x))\n",
        "\n",
        "batch_size = 4\n",
        "img_channels = 3\n",
        "img_height = 256\n",
        "img_width = 256\n",
        "num_classes = 1\n",
        "\n",
        "image = torch.randn(batch_size, img_channels, img_height, img_width)\n",
        "mask = torch.randint(0, 2, (batch_size, num_classes, img_height, img_width)).float()\n",
        "\n",
        "unet = DummyUnet(img_channels, num_classes, (img_height, img_width))\n",
        "\n",
        "output = unet(image)\n",
        "\n",
        "dice_loss = 1 - (2 * (output * mask).sum()) / (output.sum() + mask.sum() + 1e-8)\n",
        "bce_loss = F.binary_cross_entropy(output, mask)\n",
        "loss = dice_loss + bce_loss\n",
        "\n",
        "precision, recall, _ = precision_recall_curve(mask.flatten().numpy(), output.detach().numpy().flatten())\n",
        "plt.plot(recall, precision)\n",
        "plt.xlabel(\"Recall\")\n",
        "plt.ylabel(\"Precision\")\n",
        "plt.title(\"Precision-Recall Curve\")\n",
        "plt.show()\n",
        "\n",
        "print(f\"Dice Loss: {dice_loss.item()}\")\n",
        "print(f\"BCE Loss: {bce_loss.item()}\")\n",
        "print(f\"Total Loss: {loss.item()}\")"
